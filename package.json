{
  "name": "europe-unwritten",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "data:validate": "node scripts/validate-data.mjs",
    "format": "prettier --write src scripts/*.mjs tests docs *.json *.ts index.html README.md",
    "check": "npm test && npm run data:validate && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "^6.9.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
